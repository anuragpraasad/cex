// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

enum Side {
  BUY
  SELL
}

enum Type {
  LIMIT
  MARKET
}

enum Status {
  FILLED
  UNFILLED
}

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id       Int     @id @default(autoincrement())
  username String  @unique
  password String
  orders   Order[]
}

model Stock {
  id     Int     @id @default(autoincrement())
  title  String
  symbol String
  orders Order[]
  fills  Fill[]
}

model Fill {
  id          Int   @id @default(autoincrement())
  stockid     Int
  price       Int
  buyorderid  Int
  sellorderid Int
  quantity    Int
  stock       Stock @relation(fields: [stockid], references: [id])
  buyorders   Order @relation("Buyorders", fields: [buyorderid], references: [id])
  sellordes   Order @relation("Sellorders", fields: [sellorderid], references: [id])
}

model Order {
  id             Int    @id @default(autoincrement())
  userId         Int
  quantity       Int
  side           Side
  type           Type
  stockid        Int
  price          Int
  filledquantity Int
  status         Status
  buyFills       Fill[] @relation("Buyorders")
  sellFills      Fill[] @relation("Sellorders")
  user           User   @relation(fields: [userId], references: [id])
  stock          Stock  @relation(fields: [stockid], references: [id])
}
